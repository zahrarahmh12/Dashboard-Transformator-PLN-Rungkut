        opt.value = a;
        opt.textContent = a;
        elAset.appendChild(opt);
      });
    }

    // Terapkan filter aktif
    function getFilteredData() {
      const pVal = elPenyulang.value;
      const aVal = elAset.value;
      const uVal = elUnbalance.value;

      return ENRICHED_DATA.filter((row) => {
        if (pVal !== 'ALL' && row['Nama Penyulang'] !== pVal) return false;
        if (aVal !== 'ALL' && row['Nama Aset'] !== aVal) return false;
        if (uVal !== 'ALL') {
          if (uVal === 'NULL') {
            if (row['Unbalance'] !== null && row['Unbalance'] !== undefined) return false;
          } else if (uVal === '1') {
            if (Number(row['Unbalance']) !== 1) return false;
          } else if (uVal === '0') {
            if (row['Unbalance'] === null || row['Unbalance'] === undefined || Number(row['Unbalance']) !== 0) return false;
          }
        }
        return true;
      });
    }

    // Perbarui kartu KPI & rincian Unbalance
    function updateKPIsAndUnbalance(rows) {
      const count = rows.length;
      const uniqueAssets = new Set(rows.map((r) => r['Nama Aset'])).size;

      const avgPembebanan =
        count > 0 ? (rows.reduce((acc, r) => acc + Number(r['Pembebanan Trafo'] || 0), 0) / count) * 100 : 0;
      const avgBebanKva =
        count > 0 ? rows.reduce((acc, r) => acc + Number(r['Beban Trafo'] || 0), 0) / count : 0;
      const avgDeltaArus =
        count > 0 ? rows.reduce((acc, r) => acc + Number(r['Delta Arus'] || 0), 0) / count : 0;

      elKpiJumlah.textContent = String(count);
      elKpiAsetUnik.textContent = String(uniqueAssets);
      elKpiRataPembebanan.textContent = `${avgPembebanan.toFixed(2)}%`;
      elKpiRataBeban.textContent = `${avgBebanKva.toFixed(2)} kVA`;
      elKpiRataDelta.textContent = avgDeltaArus.toFixed(2);
      elFilterBadge.textContent = `Menampilkan ${count} dari ${ENRICHED_DATA.length} catatan`;

      // Pisahkan Unbalance = 1, Unbalance = 0, dan Kosong (null/undefined)
      const ub1Rows = rows.filter((r) => r['Unbalance'] !== null && r['Unbalance'] !== undefined && Number(r['Unbalance']) === 1);
      const ub0Rows = rows.filter((r) => r['Unbalance'] !== null && r['Unbalance'] !== undefined && Number(r['Unbalance']) === 0);
      const ubNullRows = rows.filter((r) => r['Unbalance'] === null || r['Unbalance'] === undefined);

      elCountUb1.textContent = String(ub1Rows.length);
      elDetailUb1.textContent =
        ub1Rows.length > 0
          ? ub1Rows.map((r) => `${shortAssetCode(r['Nama Aset'])} (${formatTanggal(r['Tanggal Pengukuran'])})`).join(', ')
          : 'Tidak ada catatan Unbalance = 1';

      elCountUb0.textContent = String(ub0Rows.length);

      elCountUbNull.textContent = String(ubNullRows.length);
      elDetailUbNull.textContent =
        ubNullRows.length > 0
          ? `${ubNullRows.map((r) => shortAssetCode(r['Nama Aset'])).join(', ')} (tidak disamakan dengan 0)`
          : 'Tidak ada nilai kosong';
    }

