          avgPct: item.count > 0 ? Number((item.sum / item.count).toFixed(2)) : 0
        }))
        .sort((a, b) => b.avgPct - a.avgPct);

      const barLabels = sortedAssets.map((a) => a.code);
      const barValues = sortedAssets.map((a) => a.avgPct);

      if (chartBarInstance) {
        chartBarInstance.destroy();
      }

      const barCtx = document.getElementById('chartPembebananAset').getContext('2d');
      chartBarInstance = new Chart(barCtx, {
        type: 'bar',
        data: {
          labels: barLabels,
          datasets: [
            {
              label: 'Rata-rata Pembebanan (%)',
              data: barValues,
              backgroundColor: sortedAssets.map((a) => (a.avgPct >= 45 ? '#60a5fa' : '#3b82f6')),
              borderRadius: 6,
              maxBarThickness: 28
            }
          ]
        },
        options: {
          indexAxis: 'y',
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: {
              callbacks: {
                title: (items) => {
                  const idx = items[0]?.dataIndex ?? 0;
                  return sortedAssets[idx]?.fullName || '';
                },
                label: (ctx) => `Pembebanan: ${Number(ctx.raw).toFixed(2)}%`
              }
            }
          },
          scales: {
            x: {
              beginAtZero: true,
              suggestedMax: 60,
              ticks: {
                callback: (val) => `${val}%`
              },
              grid: { color: '#e2e8f0' }
            },
            y: {
              grid: { display: false },
              ticks: {
                font: { weight: '600' }
              }
            }
          }
        }
      });

      // 2. Tren Pembebanan (%) & Delta Arus urut kronologis waktu pengukuran
      const chronological = [...rows].sort(
        (a, b) => new Date(a['Waktu Pengukuran'] || a['Tanggal Pengukuran']) - new Date(b['Waktu Pengukuran'] || b['Tanggal Pengukuran'])
      );

      const trendLabels = chronological.map((r) => `${formatTanggal(r['Tanggal Pengukuran'])} (${shortAssetCode(r['Nama Aset'])})`);
      const trendLoading = chronological.map((r) => Number((Number(r['Pembebanan Trafo'] || 0) * 100).toFixed(2)));
      const trendDelta = chronological.map((r) => Number(Number(r['Delta Arus'] || 0).toFixed(2)));

      if (chartTrendInstance) {
        chartTrendInstance.destroy();
      }

      const trendCtx = document.getElementById('chartTrenPengukuran').getContext('2d');
      chartTrendInstance = new Chart(trendCtx, {
        type: 'line',
        data: {
          labels: trendLabels,
          datasets: [
            {
              label: 'Pembebanan (%)',
              data: trendLoading,
              borderColor: '#3b82f6',
              backgroundColor: 'rgba(59, 130, 246, 0.12)',
              pointBackgroundColor: chronological.map((r) =>
                r['Unbalance'] !== null && r['Unbalance'] !== undefined && Number(r['Unbalance']) === 1 ? '#dc2626' : '#3b82f6'
              ),
              pointRadius: 5,
              pointHoverRadius: 7,
              borderWidth: 2.5,
              tension: 0.25,
              yAxisID: 'y'
            },
            {
              label: 'Delta Arus',
              data: trendDelta,
              borderColor: '#d97706',
              backgroundColor: 'rgba(217, 119, 6, 0.08)',
              pointBackgroundColor: '#d97706',
              pointRadius: 4,
              pointHoverRadius: 6,
              borderWidth: 2,
              borderDash: [5, 4],
              tension: 0.25,
              yAxisID: 'y1'
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          interaction: {
            mode: 'index',
            intersect: false
          },
          plugins: {
            legend: {
              position: 'top',
              labels: { usePointStyle: true, boxWidth: 10 }
            }
          },
          scales: {
            x: {
              grid: { display: false },
              ticks: {
                maxRotation: 35,
                minRotation: 0,
                font: { size: 11 }
              }
            },
            y: {
              type: 'linear',
              position: 'left',
              beginAtZero: false,
              suggestedMin: 20,
              suggestedMax: 55,
              title: { display: true, text: 'Pembebanan (%)', color: '#0f6b78', font: { weight: '600' } },
              ticks: { callback: (v) => `${v}%` },
              grid: { color: '#e2e8f0' }
            },
            y1: {
              type: 'linear',
              position: 'right',
              beginAtZero: true,
              suggestedMax: 120,
              title: { display: true, text: 'Delta Arus', color: '#b45309', font: { weight: '600' } },
              grid: { drawOnChartArea: false }
            }
          }
        }
      });
    }

    // Render badge status Unbalance
    function renderUnbalanceBadge(val) {
      if (val === null || val === undefined) {
        return `<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-800 border border-amber-200">Kosong</span>`;
      }
      if (Number(val) === 1) {
        return `<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-rose-100 text-rose-800 border border-rose-200">1 (Unbalance)</span>`;
      }
      return `<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800 border border-emerald-200">0</span>`;
    }

    // Render blok detail lengkap 48 kolom untuk baris yang diperluas
    function render48ColumnDetail(row) {
      const keys = Object.keys(RAW_DATA[0]);
      const itemsHtml = keys
        .map((k) => {
          const val = row[k];
          let displayVal = formatVal(val, 4);
          if (k === 'Pembebanan Trafo' && typeof val === 'number') {
            displayVal = `${(val * 100).toFixed(2)}% (${val.toFixed(6)})`;
          } else if (k === 'Tanggal Pengukuran') {
            displayVal = formatTanggal(val);
          } else if (k === 'Waktu Pengukuran') {
            displayVal = formatWaktu(val);
          }
          return `
            <div class="bg-white rounded-lg p-2.5 border border-slate-200/90">
              <div class="text-[11px] font-semibold text-slate-500 truncate" title="${k}">${k}</div>
              <div class="text-xs font-bold text-slate-800 mt-0.5 break-words">${displayVal}</div>
            </div>
          `;
        })
        .join('');

      return `
        <div class="p-4 bg-slate-50/90 border-t border-slate-200">
          <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
            <div class="text-xs font-bold uppercase tracking-wider text-blue-900">
              Rincian Lengkap 48 Kolom — ${row['Nama Aset']} (${formatTanggal(row['Tanggal Pengukuran'])})
            </div>
            <span class="text-xs text-slate-500">
              Koordinat: ${row['Latitude Aset']}, ${row['Longitude Aset']} • Konstruksi: ${row['Konstruksi Aset']}
            </span>
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-2.5">
            ${itemsHtml}
          </div>
        </div>
      `;
    }

    // Render tabel utama 12 catatan
    function updateTable(rows) {
      if (rows.length === 0) {
        elTableBody.innerHTML = `
          <tr>
            <td colspan="9" class="px-4 py-8 text-center text-sm text-slate-500">
              Tidak ada catatan pengukuran yang sesuai dengan filter yang dipilih.
            </td>
          </tr>
        `;
        return;
      }

      const htmlParts = [];
      rows.forEach((row) => {
        const id = row._recordIndex;
        const isExpanded = expandedRowIds.has(id);
        const pembebananPct = (Number(row['Pembebanan Trafo'] || 0) * 100).toFixed(2);

        htmlParts.push(`
          <tr class="hover:bg-sky-50/50 transition">
            <td class="px-3.5 py-3 font-semibold text-slate-700 whitespace-nowrap">${id}</td>
            <td class="px-3.5 py-3 whitespace-nowrap">
              <div class="font-medium text-slate-800">${formatTanggal(row['Tanggal Pengukuran'])}</div>
              <div class="text-xs text-slate-500">${formatWaktu(row['Waktu Pengukuran'])}</div>
            </td>
            <td class="px-3.5 py-3 font-medium text-slate-700 whitespace-nowrap">${row['Nama Penyulang']}</td>
            <td class="px-3.5 py-3 text-slate-800 font-medium min-w-[220px]">${row['Nama Aset']}</td>
            <td class="px-3.5 py-3 text-right font-semibold text-slate-800 whitespace-nowrap">${Number(row['Beban Trafo']).toFixed(3)}</td>
            <td class="px-3.5 py-3 text-right font-bold text-[#0f6b78] whitespace-nowrap">${pembebananPct}%</td>
            <td class="px-3.5 py-3 text-right font-medium text-slate-700 whitespace-nowrap">${Number(row['Delta Arus']).toFixed(2)}</td>
            <td class="px-3.5 py-3 text-center whitespace-nowrap">${renderUnbalanceBadge(row['Unbalance'])}</td>
            <td class="px-3.5 py-3 text-center whitespace-nowrap">
              <button
                type="button"
                data-toggle-id="${id}"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold ${
                  isExpanded
                    ? 'bg-[#17365d] text-white'
                    : 'bg-slate-100 hover:bg-slate-200 text-slate-700'
                } transition cursor-pointer"
              >
                <span>${isExpanded ? 'Tutup' : 'Detail 48 Kolom'}</span>
              </button>
            </td>
          </tr>
        `);

        if (isExpanded) {
          htmlParts.push(`
            <tr>
              <td colspan="9" class="p-0">
                ${render48ColumnDetail(row)}
              </td>
            </tr>
          `);
        }
      });

      elTableBody.innerHTML = htmlParts.join('');

      // Pasang event listener tombol Detail 48 Kolom
      elTableBody.querySelectorAll('button[data-toggle-id]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const recId = Number(btn.getAttribute('data-toggle-id'));
          if (expandedRowIds.has(recId)) {
            expandedRowIds.delete(recId);
          } else {
            expandedRowIds.add(recId);
          }
          updateTable(getFilteredData());
        });
      });
    }

    // Refresh seluruh tampilan dashboard
    function renderDashboard() {
      const filtered = getFilteredData();
      updateKPIsAndUnbalance(filtered);
      updateCharts(filtered);
      updateTable(filtered);
    }

    // Event listeners filter & reset
    [elPenyulang, elAset, elUnbalance].forEach((selectEl) => {
      selectEl.addEventListener('change', renderDashboard);
    });

    elReset.addEventListener('click', () => {
      elPenyulang.value = 'ALL';
      elAset.value = 'ALL';
      elUnbalance.value = 'ALL';
      renderDashboard();
    });

    // Inisialisasi awal saat dokumen siap
    document.addEventListener('DOMContentLoaded', () => {
      initFilterOptions();
      renderDashboard();
    });
  </script>
</body>
</html>